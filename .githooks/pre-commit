#!/usr/bin/env bash
# pre-commit — the fast lint gates, enforced so they cannot be silently skipped (review F-1).
# ruff format --check is one of the six ci_local.sh gates; hosted Actions is startup-dead and the
# bar had degraded to "a human remembers to run the script". This runs the two fast gates on every
# commit. The FULL stack (mypy, pytest, lint-imports, conformance) stays in scripts/ci_local.sh —
# run it before every push/milestone. Activate once per clone: git config core.hooksPath .githooks
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
RUFF="$(command -v ruff || echo .venv/bin/ruff)"
fail=0
echo "pre-commit: ruff format --check"
"$RUFF" format --check || { echo "  -> run: ruff format"; fail=1; }
echo "pre-commit: ruff check"
"$RUFF" check || fail=1

# Sprint 224h gate: `# noqa: BLE001` with no trailing rationale is banned.
# Every wide `except Exception` catch must name the boundary (HTTP handler
# top, background sweep, mid-write read) or the class(es) the wide catch
# subsumes. Zero rationale-less BLE001 sites remain as of ee7054c6; this
# gate makes drift loud rather than silent.
echo "pre-commit: BLE001-rationale gate"
if grep -rn 'noqa: BLE001[[:space:]]*$' src/ tests/ 2>/dev/null; then
  echo "  ^^ BLE001 sites above have no rationale. Add '— <boundary or class list>' after the noqa."
  fail=1
fi

# REVIEW-2026-08-28 Q1 gate: mypy strict on `src/substrate`. The BLACKBOARD
# claimed "mypy strict clean" 111 times across 2026-06 through 2026-08; at
# review open, mypy strict was returning 10 errors across 6 files. The
# check runs in about 4 seconds when the cache is warm. Adding it to the
# pre-commit gate closes the "green is not proven" class named in memory
# `be-your-own-skeptic-green-is-not-proven`. `scripts/ci_local.sh` runs
# the full stack (pytest + lint-imports + conformance); this gate keeps
# mypy at every commit.
echo "pre-commit: mypy --strict src/substrate"
UV="$(command -v uv || echo .venv/bin/uv)"
MYPY_LOG="$(mktemp -t substrate-mypy.XXXXXX)"  # its own temp file, not a shared /tmp path (F293)
trap 'rm -f "$MYPY_LOG"' EXIT
if ! "$UV" run mypy --strict src/substrate > "$MYPY_LOG" 2>&1; then
  tail -15 "$MYPY_LOG"
  echo "  ^^ mypy strict violations. Fix or add a scoped [tool.mypy.overrides] entry with justification."
  fail=1
fi

# Import contracts (lens audit F061, F199): the CLI imports only api and app, and every unit
# imports only the units below it (pyproject [tool.importlinter]). About 2 s.
echo "pre-commit: lint-imports"
"$UV" run lint-imports > "$MYPY_LOG" 2>&1 || { tail -20 "$MYPY_LOG"; fail=1; }

# Status-literal gate (Sprint 224h; UI sprint 107; lens audit F292): one script, both repos.
echo "pre-commit: status-literal-comparison gate"
UI_SRC=""
[ -d ../substrate-ui ] && UI_SRC="$(ls ../substrate-ui/*.py) ../substrate-ui/scripts ../substrate-ui/web"
# shellcheck disable=SC2086
bash scripts/check_status_literals.sh src/ scripts/ $UI_SRC || fail=1

[ "$fail" -ne 0 ] && echo "pre-commit FAILED — fix the above (or: git commit --no-verify to override deliberately)"
exit $fail
